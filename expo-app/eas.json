{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_USE_MOCK": "true",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "development"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_USE_MOCK": "true",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "development"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_USE_MOCK": "true",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "internal"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "beta": {
      "distribution": "store",
      "channel": "beta",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "beta"
      }
    },
    "tester": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_USE_MOCK": "false",
        "EXPO_PUBLIC_RELEASE_CHANNEL": "production",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "132642896276-qceu7dn7hstcj4ghcl9meg3mlajoolto.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "replace-with-app-store-connect-id"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "beta": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}